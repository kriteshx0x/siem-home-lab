<!-- Local custom Wazuh rules -->
<group name="local,custom,">

  <!-- SSH failed authentication -->
  <rule id="100002" level="7">
    <decoded_as>sshd</decoded_as>
    <match>Failed password</match>
    <description>SSH failed login detected</description>
    <group>authentication_failed,ssh,</group>
  </rule>

  <!-- SSH authentication failure -->
  <rule id="100010" level="7">
    <if_sid>5716</if_sid>
    <description>SSH authentication failure detected</description>
    <group>authentication_failed,ssh,</group>
  </rule>

  <!-- Multiple SSH authentication failures -->
  <rule id="100011" level="10">
    <if_matched_sid>100010</if_matched_sid>
    <description>Multiple SSH authentication failures detected</description>
    <group>authentication_failed,ssh,brute_force,</group>
  </rule>

  <!-- Suspicious command execution -->
  <rule id="100020" level="10">
    <match>sudo|COMMAND=</match>
    <description>Suspicious privileged command execution detected</description>
    <group>command_execution,privilege_escalation,</group>
  </rule>

  <!-- Pass-the-Hash / NTLM authentication indicator -->
  <rule id="100021" level="12">
    <match>NTLM|pass.the.hash|Pass-the-Hash</match>
    <description>Possible Pass-the-Hash authentication detected</description>
    <group>authentication,credential_access,pass_the_hash,</group>
  </rule>

</group>



<group name="windows,windows_security,kerberos,">

  <rule id="100022" level="12">
    <if_sid>60106</if_sid>
    <match>MSSQLSvc/</match>
    <description>Suspicious Kerberos SQL service ticket requested</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>authentication,credential_access,kerberos,</group>
  </rule>

</group>
